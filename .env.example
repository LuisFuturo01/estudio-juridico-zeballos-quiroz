# =====================================================================
#  Estudio Jurídico Zeballos Quiroz — Variables de entorno
# ---------------------------------------------------------------------
#  1. Copie este archivo como `.env` (o `.env.local`) y complete valores.
#  2. NUNCA suba `.env` al repositorio (ya está en .gitignore).
#  3. IMPORTANTE: toda variable con prefijo VITE_ se incrusta en el
#     JavaScript público del sitio. Solo coloque aquí valores que sean
#     seguros de exponer en el navegador (p. ej. la Public Key de EmailJS
#     o la URL de su propio endpoint). Las claves secretas (Resend,
#     OpenAI, Anthropic, Gemini...) deben vivir SOLO en el servidor /
#     función serverless (ver carpeta /server y README.md).
# =====================================================================

# ---------------------------------------------------------------------
# Proveedor del formulario de contacto
#   emailjs -> envío directo desde el navegador vía EmailJS (REST API)
#   api     -> POST JSON a su propio endpoint (Resend, SendGrid, etc.)
#   none    -> modo demostración: no envía, solo simula éxito y ofrece WhatsApp
# ---------------------------------------------------------------------
VITE_CONTACT_PROVIDER=none

# --- EmailJS (https://dashboard.emailjs.com) -------------------------
# Service ID  -> Email Services
# Template ID -> Email Templates (variables usadas: from_name, phone,
#                reply_to, specialty, message, language)
# Public Key  -> Account > General (está pensada para ser pública)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# --- Endpoint propio (VITE_CONTACT_PROVIDER=api) ---------------------
# URL de su función serverless que recibe el POST JSON del formulario
# y envía el correo con Resend/SendGrid. Ej: https://zeballosquiroz.bo/api/contact
VITE_CONTACT_API_URL=

# --- Asistente legal (futuro LLM) ------------------------------------
# static -> mini-modelo local basado en legal_agent_knowledge.json (por defecto)
# remote -> envía la consulta a VITE_AI_AGENT_ENDPOINT (su backend, que a su
#           vez llama a OpenAI / Anthropic / Gemini con la clave secreta).
#           Si el endpoint falla, el asistente vuelve automáticamente al modo static.
VITE_AI_AGENT_MODE=static
VITE_AI_AGENT_ENDPOINT=

# =====================================================================
#  SOLO SERVIDOR (no usar prefijo VITE_; leídas por /server/*.js)
# =====================================================================
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# CONTACT_TO_EMAIL=contacto@zeballosquiroz.bo
# CONTACT_FROM_EMAIL=web@zeballosquiroz.bo
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
